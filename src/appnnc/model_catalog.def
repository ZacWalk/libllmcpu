NNC_MODEL("embeddinggemma-300m-q8", "embeddinggemma-300M-Q8_0.gguf", "https://huggingface.co/ggml-org/embeddinggemma-300M-GGUF/resolve/main/embeddinggemma-300M-Q8_0.gguf", 333590944, "EmbeddingGemma 300M: text to vectors, for search and similarity")
NNC_MODEL("embeddinggemma-2-q8", "embeddinggemma-2-Q8_0.gguf", "https://huggingface.co/ggml-org/embeddinggemma-2-GGUF/resolve/main/embeddinggemma-2-Q8_0.gguf", 309855456, "EmbeddingGemma 2: newer text embeddings, for texts up to 8K tokens")
NNC_MODEL("gemma-3-1b-bf16", "gemma-3-1b-it-BF16.gguf", "https://huggingface.co/unsloth/gemma-3-1b-it-GGUF/resolve/main/gemma-3-1b-it-BF16.gguf", 2006573344, "Gemma 3 1B instruct, 16-bit source weights (for --bf16)")
NNC_MODEL("mtp-gemma-4-e2b-q8", "mtp-gemma-4-E2B-it-Q8_0.gguf", "https://huggingface.co/ggml-org/gemma-4-E2B-it-GGUF/resolve/main/mtp-gemma-4-E2B-it-Q8_0.gguf", 97817696, "MTP drafter for Gemma 4 E2B: faster replies, used automatically")
NNC_MODEL("mtp-gemma-4-e4b-q8", "mtp-gemma-4-E4B-it-Q8_0.gguf", "https://huggingface.co/ggml-org/gemma-4-E4B-it-GGUF/resolve/main/mtp-gemma-4-E4B-it-Q8_0.gguf", 98653280, "MTP drafter for Gemma 4 E4B: faster replies, used automatically")
NNC_MODEL("mtp-gemma-4-26b-a4b-q8", "mtp-gemma-4-26B-A4B-it-Q8_0.gguf", "https://huggingface.co/ggml-org/gemma-4-26B-A4B-it-GGUF/resolve/main/mtp-gemma-4-26B-A4B-it-Q8_0.gguf", 461766784, "MTP drafter for Gemma 4 26B A4B: faster replies, used automatically")
